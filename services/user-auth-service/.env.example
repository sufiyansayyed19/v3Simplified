SERVICE_NAME=user-auth-service
HOST=0.0.0.0
PORT=8001
DATABASE_URL=postgresql+psycopg://user_auth_user:user_auth_pass@localhost:5432/user_db

# Corporate Email OTP
COMPANY_EMAIL_DOMAIN=company.com
OTP_EXPIRE_MINUTES=5
EMAIL_SENDER_MODE=console
ENVIRONMENT=development

# HS256 JWT Authentication
JWT_SECRET_KEY=super-secret-jwt-key-for-corporate-parking
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
